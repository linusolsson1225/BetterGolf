@using System.Globalization
@using BetterGolfASP.Domain.Models.Products
@model Product

@{
    ViewBag.Title = Model.Name + " - BetterGolf";
}

<div class="container py-5">
    <div class="row g-5 align-items-center">

        <!-- ProductImage -->
        <div class="col-md-6 text-center">
            <div class="product-image-wrapper border rounded-4 shadow-sm p-3 bg-white">
                @if (Model.ImgUrls != null && Model.ImgUrls.Count > 0)
                {
                    <div class="mb-3">
                        <img id="mainProductImage"
                             src="@Model.ImgUrls[0]"
                             alt="@Model.Name"
                             class="img-fluid rounded shadow-sm"
                             style="max-height: 400px; object-fit: contain;" />
                    </div>

                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        @for (int i = 0; i < Model.ImgUrls.Count; i++)
                        {
                            var imageUrl = Model.ImgUrls[i];
                            <img src="@imageUrl"
                                 alt="@Model.Name"
                                 class="img-thumbnail thumbnail-img"
                                 style="width: 80px; height: 80px; object-fit: cover; cursor: pointer;" />
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">No images uploaded yet.</p>
                }
            </div>
        </div>

        <!-- Product information -->
        <div class="col-md-6">
            <h1 class="fw-bold mb-3">@Model.Name</h1>
            <p class="text-muted">@Model.Description</p>

            <!-- Price + Stock badge -->
            <div class="d-flex align-items-center mb-3">
                <span class="h3 text-success fw-semibold me-3">
                    @Model.Price.ToString("C", CultureInfo.CreateSpecificCulture("en-US"))
                </span>
                <span id="stockBadge"
                      data-total-stock="@Model.GetTotalStock()"
                      class="badge @(Model.GetTotalStock() > 0 ? "bg-success" : "bg-danger")">
                    @(Model.GetTotalStock() > 0 ? "In Stock" : "Out of Stock")
                </span>
            </div>

            <hr>

            <!-- Variant dropdown -->
            @if (Model.HasVariants)
            {
                <div class="mb-3">
                    <label for="variantSelect" class="form-label fw-semibold">Choose a variant:</label>
                    <select id="variantSelect" class="form-select">
                        <option value="">-- Select variant --</option>
                        @foreach (var variant in Model.Variants)
                        {
                            <option value="@variant.VariantId"
                                    data-stock="@variant.Stock">
                                @variant.AttributeName: @variant.AttributeValue
                            </option>
                        }
                    </select>
                </div>
            }

            <div class="d-flex gap-3">
                <button class="btn btn-success add-to-cart"
                        data-id="@Model.ProductId"
                        data-name="@Model.Name"
                        data-price="@Model.Price"
                        data-quantity="1"
                        @(Model.HasVariants ? "disabled" : "")>
                    Add to Cart
                </button>

                <a href="@Url.Action("Index", "Products")" class="btn btn-outline-secondary btn-lg px-4">
                    <i class="bi bi-arrow-left me-2"></i>Back to Products
                </a>
            </div>
        </div>
    </div>
</div>
