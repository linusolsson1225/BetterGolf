@using System.Globalization
@using BetterGolfASP.Domain.Cart
@model List<CartItem>

@if (Model == null || !Model.Any())
{
    <div class="text-center text-muted py-3">
        <i class="bi bi-cart-x fs-2 d-block mb-2"></i>
        <p>Your cart is empty.</p>
    </div>
}
else
{
    <ul class="list-group list-group-flush">
        @foreach (var item in Model)
        {
            <li class="list-group-item cart-item d-flex justify-content-between align-items-center py-3">
                <div class="cart-item-left d-flex align-items-center gap-3">
                    <img src="@item.ImageUrl" 
                         alt="@item.Name" 
                         class="rounded" 
                         style="width:60px;height:60px;object-fit:cover;" />
                    <div>
                        <span class="fw-semibold d-block">@item.Name</span>
                        @if (item.VariantId != null)
                        {
                            //<small class="text-muted">Variant ID: @item.VariantId</small>
                            <small class="text-muted">@item.VariantName @item.VariantAttributeValue</small>
                        }
                    </div>
                </div>

                <div class="cart-item-right d-flex align-items-center gap-2">
                    <!-- Decrease -->
                    <button class="quantity-btn btn btn-sm btn-outline-secondary px-2"
                            data-product-id="@item.ProductId"
                            data-variant-id="@(item.VariantId?.ToString() ?? "")"
                            data-action="decrease"
                            title="Decrease quantity">−</button>

                    <!-- Quantity -->
                    <span class="fw-semibold" style="min-width: 20px; text-align:center;">@item.Quantity</span>

                    <!-- Increase -->
                    <button class="quantity-btn btn btn-sm btn-outline-secondary px-2"
                            data-product-id="@item.ProductId"
                            data-variant-id="@(item.VariantId?.ToString() ?? "")"
                            data-action="increase"
                            title="Increase quantity">+</button>

                    <!-- Line total -->
                    <td>@((item.Price * item.Quantity).ToString("C", CultureInfo.CreateSpecificCulture("en-US")))</td>

                </div>
            </li>
        }
    </ul>

    <hr class="my-3" />

    <!-- Cart total -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="fw-semibold fs-5">Total:</span>
        <span class="fw-bold fs-5">
            @Model.Sum(x => x.Quantity * x.Price).ToString("C", CultureInfo.CreateSpecificCulture("en-US"))
        </span>
    </div>

    <!-- Checkout button -->
    <div class="text-center">
        <a href="@Url.Action("Index", "Checkout")" class="btn btn-success w-100 py-2">
            Go to Checkout
        </a>
    </div>
}
